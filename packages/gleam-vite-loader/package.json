{
  "name": "@chouquette/gleam-vite-loader",
  "version": "1.0.0",
  "description": "Vite Loader handling `gleam:` protocol, to load Gleam files directly.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghivert/gleam-loaders.git"
  },
  "keywords": [
    "gleam",
    "vite",
    "ffi",
    "loader"
  ],
  "license": "MIT",
  "files": [
    "src/**/*.mjs",
    "src/**/*.d.mts",
    "src/**/*.d.ts",
    "src/**/*.d.mts.map"
  ],
  "exports": {
    ".": "./src/importer.mjs",
    "./logger": "./src/logger.mjs"
  },
  "dependencies": {
    "toml": "^3.0.0"
  },
  "peerDependencies": {
    "@chouquette/gleam": "^1.14.0",
    "vite": "^7.3.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
