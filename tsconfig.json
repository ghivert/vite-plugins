{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
  },
}
